{
  "packages": [
    {
      "name": "powershell7",
      "source": "custom",
      "installerUrl": "https://github.com/PowerShell/PowerShell/releases/download/v7.6.6/PowerShell-7.6.6-win-x64.msi",
      "switches": "/qn /norestart ADD_EXPLORER_CONTEXT_MENU_OPENPOWERSHELL=1 REGISTER_MANIFEST=1",
      "detectPath": "C:\\Program Files\\PowerShell\\7\\pwsh.exe"
    },
    {
      "name": "firefox",
      "source": "chocolatey"
    },
    {
      "name": "vscodium",
      "source": "chocolatey"
    },
    {
      "name": "notepadplusplus",
      "source": "chocolatey"
    },
    {
      "name": "vcredist-all",
      "source": "chocolatey"
    },
    {
      "name": "obsidian",
      "source": "custom",
      "installerUrl": "https://github.com/obsidianmd/obsidian-releases/releases/download/v1.13.7/Obsidian-1.13.7.exe",
      "installerType": "exe",
      "detectPath": "C:\\Program Files\\Obsidian\\Obsidian.exe",
      "switches": "/S /ALLUSERS"
    },
    {
      "name": "webrtc-redirector",
      "source": "custom",
      "installerUrl": "https://aka.ms/msrdcwebrtcsvc/msi",
      "switches": "/qn /norestart",
      "installerType": "msi",
      "detectPath": "C:\\Program Files\\Remote Desktop WebRTC Redirector\\MsRdcWebRTCSvc.exe"
    },
    {
      "name": "flameshot",
      "source": "custom",
      "installerUrl": "https://github.com/flameshot-org/flameshot/releases/download/v14.0.0/Flameshot-14.0.0-win64.msi",
      "switches": "/qn /norestart",
      "installerType": "msi",
      "detectPath": "C:\\Program Files\\Flameshot\\bin\\flameshot.exe"
    },
    {
      "name": "microsoft-office-deployment",
      "source": "chocolatey",
      "switches": "'/64bit /Product:O365ProPlusRetail /Exclude:Access,Lync,Publisher'"
    }
  ]
}
